{
 "services": [
  {
   "name": "Janus",
   "dir_env": "JANUS",
   "dir_default": "/Users/devrev/janus",
   "patterns": "./internal/service/...",
   "iface_pkg": "github.com/devrev/janus-client/api",
   "iface": "JanusServer",
   "impl_pkg": "github.com/devrev/janus/internal/service",
   "impl": "Janus",
   "op_map_file": "opmap.json",
   "field_map_file": "fieldmap.json"
  },
  {
   "name": "Codex",
   "dir_env": "CODEX",
   "dir_default": "/Users/devrev/codex",
   "patterns": "./internal/serverv2/...",
   "iface_pkg": "github.com/devrev/codex-client/apiv2",
   "iface": "CodexServer",
   "impl_pkg": "github.com/devrev/codex/internal/serverv2",
   "impl": "Codex",
   "op_map_file": "opmap.codex.json"
  },
  {
   "name": "S3Interact",
   "dir_env": "S3INTERACT",
   "dir_default": "/Users/devrev/s3interact",
   "patterns": "./internal/server/...",
   "iface_pkg": "github.com/devrev/artifacts-client/api",
   "iface": "ArtifactsServer",
   "impl_pkg": "github.com/devrev/s3interact/internal/server",
   "impl": "S3Interact",
   "op_map_file": "opmap.s3interact.json"
  },
  {
   "name": "Notifications",
   "dir_env": "NOTIFICATIONS",
   "dir_default": "/Users/devrev/notifications",
   "patterns": "./...",
   "iface_pkg": "github.com/devrev/notifications-client/api",
   "iface": "NotificationServiceServer",
   "impl_pkg": "github.com/devrev/notifications/internal/server",
   "impl": "GRPCServer",
   "op_map_file": "opmap.notifications.json"
  }
 ]
}
